generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.js (Prisma 7).
datasource db {
  provider = "postgresql"
}

// --- Accounts ---

enum Role {
  CUSTOMER
  STAFF // checks tickets at the door
  ADMIN
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique // stored lower-cased
  // Empty until the sign-up link is opened: name and password are chosen on that page, by
  // whoever holds the inbox, never by whoever typed the address into the sign-up form.
  passwordHash    String?
  name            String
  role            Role         @default(CUSTOMER)
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  sessions        Session[]
  emailTokens     EmailToken[]
  bookings        Booking[]
}

// A login. The cookie holds a random token; only its SHA-256 hash is stored, so a leaked
// database does not leak usable sessions. Deleting the row logs the user out at once.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// One-time links sent by e-mail; hashed like sessions.
model EmailToken {
  id        String         @id @default(cuid())
  tokenHash String         @unique
  type      EmailTokenType
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  // No longer read or written (sign-up links carry no password). Dropped in the next migration,
  // once the code that still writes it is no longer live.
  passwordHash String?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

// --- Catalogue ---

model Movie {
  id            String     @id @default(cuid())
  slug          String     @unique
  titleTr       String
  titleEn       String
  originalTitle String
  year          Int
  director      String
  runtimeMin    Int
  summaryTr     String
  summaryEn     String
  // Typographic poster (no image files): two colours used by the poster component.
  posterInk     String
  posterPaper   String
  createdAt     DateTime   @default(now())
  showtimes     Showtime[]
}

model Hall {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  seats     HallSeat[]
  showtimes Showtime[]
}

enum SeatKind {
  STANDARD
  ACCESSIBLE // wheelchair space
}

// A physical seat. `col` is the position on the drawn map, so aisles are just missing columns.
model HallSeat {
  id      String        @id @default(cuid())
  hallId  String
  hall    Hall          @relation(fields: [hallId], references: [id], onDelete: Cascade)
  row     String // "A", "B", ...
  number  Int // seat number printed on the ticket
  col     Int
  kind    SeatKind      @default(STANDARD)
  tickets BookingSeat[]

  @@unique([hallId, row, number])
  @@index([hallId])
}

model Showtime {
  id         String        @id @default(cuid())
  movieId    String
  movie      Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  hallId     String
  hall       Hall          @relation(fields: [hallId], references: [id], onDelete: Restrict)
  startsAt   DateTime
  priceCents Int // money as whole kuruş: no rounding errors
  bookings   Booking[]
  seats      BookingSeat[]

  @@unique([hallId, startsAt]) // one show at a time per hall (overlaps are checked in code)
  @@index([movieId])
  @@index([startsAt])
}

// --- Bookings ---

enum BookingStatus {
  HOLD // seats reserved for a few minutes while the customer pays
  PAID
  CANCELLED
  EXPIRED // the hold ran out before payment
}

model Booking {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  showtimeId      String
  showtime        Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  status          BookingStatus @default(HOLD)
  holdExpiresAt   DateTime
  totalCents      Int
  stripeSessionId String?       @unique
  stripeLang      String? // language of the checkout, used for the ticket e-mail
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  seats           BookingSeat[]

  @@index([userId])
  @@index([showtimeId, status])
}

// A seat in a booking; for a paid booking this row is the ticket.
// The unique (showtimeId, hallSeatId) pair is what makes double booking impossible: two
// customers inserting the same seat at the same moment cannot both succeed, whatever the
// application code does. Rows of expired or cancelled bookings are deleted to free the seat.
model BookingSeat {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showtimeId  String
  showtime    Showtime  @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  hallSeatId  String
  hallSeat    HallSeat  @relation(fields: [hallSeatId], references: [id], onDelete: Restrict)
  checkedInAt DateTime?

  @@unique([showtimeId, hallSeatId])
  @@index([bookingId])
}

// --- Rate limiting ---

// Fixed-window counters, shared by every serverless instance (memory is not shared on Vercel).
// Incremented with one atomic INSERT ... ON CONFLICT statement (server/rateLimit.js).
model RateLimitBucket {
  key     String   @id // "login:ip:1.2.3.4", "login:email:a@b.c", ...
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
