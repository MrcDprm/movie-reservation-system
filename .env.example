# Never commit real values. Copy to .env for local development.

# Neon Postgres: pooled connection for the app, direct connection for migrations (Prisma CLI)
DATABASE_URL=
DIRECT_URL=

# Public address of the site (the only origin allowed to call the API)
APP_ORIGIN=http://localhost:5173

# Resend (https://resend.com/api-keys). Without a key, e-mails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=Klasik Sinema <bilet@miracdeprem.com>

# Stripe test mode only (sk_test_...). The webhook secret comes from the Stripe dashboard
# (production endpoint) or from `stripe listen` (local).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signs the QR codes on tickets; at least 32 characters (openssl rand -base64 48).
# Optional locally (a fixed development value is used), required in production.
TICKET_SECRET=
