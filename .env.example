# PostgreSQL
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema_secret
POSTGRES_DB=movie_reservation

# Backend
DATABASE_URL=postgresql://cinema:cinema_secret@postgres-db:5432/movie_reservation?schema=public
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=production

# Frontend (baked into Vite build; browser calls host-mapped backend)
VITE_API_URL=http://localhost:5000/api
